NODE_ENV=development
PORT=8000
# PDF invoices (Puppeteer). Docker sets this to /usr/bin/chromium-browser automatically.
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser
# Set to true to skip Mailtrap/SMTP sends locally (logs recipient instead)
# Skip outbound email locally (avoids Mailtrap quota crashes)
EMAIL_SEND_DISABLED=true
FRONTEND_APP_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

DB_USERNAME=
DB_PASSWORD=
DB_URL=mongodb://127.0.0.1:27017/gosource
DB_USERNAME_PROD=
DB_PASSWORD_PROD=
DB_URL_PROD=mongodb://127.0.0.1:27017/gosource

JWT_SECRET=replace-with-a-secure-jwt-secret
JWT_EXPIRES_IN=1d

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_CLOUD_NAME_PROD=
CLOUDINARY_API_KEY_PROD=
CLOUDINARY_API_SECRET_PROD=

SMTP_HOST_NAME=
SMTP_BULK_HOST_NAME=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co

CDN_SECRET=
CDN_ACCESS_KEY=
CDN_BUCKET_NAME=
CDN_URL=

ENCRYPTION_KEY=
ENCRYPTION_IV=

TERMII_KEY=

REDIS_URL=redis://127.0.0.1:6379
SLACK_USERS_WEBHOOK_URL=

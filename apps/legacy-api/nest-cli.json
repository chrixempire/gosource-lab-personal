{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": [
      {
        "include": "notification/firebase/gosource-fcm.json",
        "watchAssets": true
      },
      {
        "include": "templates/pdf/assets/**/*",
        "watchAssets": true
      }
    ]
  }
}
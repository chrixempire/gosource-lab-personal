<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Purchase Order Notification</title>
    <link
      href="https://fonts.cdnfonts.com/css/graphik-trial"
      rel="stylesheet"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@100;200;300;400;500;600;700;800;900&display=swap"
      rel="stylesheet"
    />
  </head>

  <body
    style="
      margin: 0;
      padding: 0;
      background-color: #f4f4f4;
      font-family: 'Inter', sans-serif;
    "
  >
    <table
      style="
        width: 100%;
        max-width: 600px;
        margin: 40px auto;
        background-color: #fff;
        border-radius: 8px;
        overflow: hidden;
        box-shadow: 0 0 10px rgba(0, 0, 0, 0.05);
      "
    >
      <!-- Header -->
      <tr>
        <td
          style="
            background-color: #09420c;
            padding: 24px;
            text-align: left;
            color: #fff;
            font-size: 20px;
            font-weight: bold;
          "
        >
          <div
            style="
              display: flex;
              justify-content: space-between;
              align-items: center;
            "
          >
            <img
              src="https://gosource.sfo3.cdn.digitaloceanspaces.com/Frame%201000002518.png"
              alt="GoSource"
            />
            <p
              style="margin: 0; color: #fff; font-size: 28px; font-weight: 600"
            >
              #<%=  id.slice(-6) %>
            </p>
          </div>
        </td>
      </tr>

      <!-- Order Details -->
      <tr>
        <td colspan="2" style="padding: 24px">
          <div style="display: flex; justify-content: space-between">
            <div>
              <p style="margin: 0; font-size: 14px; color: #667185">
                Expected date
              </p>
              <p
                style="
                  margin: 12px 0 20px;
                  font-size: 14px;
                  font-weight: 500;
                  color: #232b38;
                "
              >
                <%= new Date( expectedDate).toLocaleDateString() %>
              </p>
            </div>

            <div>
              <p style="margin: 0; font-size: 14px; color: #667185">
                Ordered by
              </p>
              <p
                style="
                  margin: 12px 0 20px;
                  font-size: 14px;
                  font-weight: 500;
                  color: #232b38;
                "
              >
                <%=  suppliers[0].firstName %> <%=  suppliers[0].lastName %>
              </p>
            </div>
          </div>

          <p
            style="
              margin: 0;
              font-size: 14px;
              color: #667185;
              padding-top: 16px;
              padding-bottom: 12px;
            "
          >
            Bill to
          </p>
          <p
            style="
              margin: 0;
              font-size: 14px;
              font-weight: 500;
              color: #232b38;
              padding-bottom: 12px;
            "
          >
            <%=  suppliers[0].firstName %> <%=  suppliers[0].lastName %>
          </p>
          <p
            style="margin: 0; font-size: 14px; font-weight: 500; color: #232b38"
          >
            <%=  suppliers[0].email %>
          </p>
        </td>
      </tr>

      <!-- Purchase Order Table -->
      <tr>
        <td colspan="2" style="padding: 0 24px">
          <table
            style="
              width: 100%;
              border-collapse: separate;
              border-spacing: 0;
              background-color: #fff;
              border-radius: 12px;
              overflow: hidden;
              border: 1px solid #f0f2f5;
            "
          >
            <thead>
              <tr
                style="
                  background-color: #f0f2f5;
                  text-align: left;
                  border-radius: 12px;
                "
              >
                <th
                  style="
                    padding: 12px;
                    font-size: 14px;
                    color: #667185;
                    font-weight: 400;
                  "
                >
                  No.
                </th>
                <th
                  style="
                    padding: 12px;
                    font-size: 14px;
                    color: #667185;
                    font-weight: 400;
                  "
                >
                  Item
                </th>
                <th
                  style="
                    padding: 12px;
                    font-size: 14px;
                    color: #667185;
                    font-weight: 400;
                  "
                >
                  Qty
                </th>
                <th
                  style="
                    padding: 12px;
                    font-size: 14px;
                    color: #667185;
                    font-weight: 400;
                  "
                >
                  Rate
                </th>
                <th
                  style="
                    padding: 12px;
                    font-size: 14px;
                    color: #667185;
                    font-weight: 400;
                  "
                >
                  Price
                </th>
              </tr>
            </thead>
            <tbody>
              <% let total = 0; %>
              <%  products.forEach((product, index) => { %>
              <% const quantity = Number(product.quantity || 0); %>
              <% const lineTotal = Number(product.totalPrice || 0); %>
              <% const explicitUnitPrice = quantity > 0 ? lineTotal / quantity : 0; %>
              <% const productPrice = Number(product?.product?.discountPrice ?? product?.product?.marketPrice ?? explicitUnitPrice || 0); %>
              <% const price = lineTotal || (quantity * productPrice); %>
              <% total += price; %>
              <tr>
                <td
                  style="
                    padding: 12px;
                    font-size: 14px;
                    color: #232b38;
                    font-weight: 400;
                  "
                >
                  <%= index + 1 %>.
                </td>
                <td
                  style="
                    padding: 12px;
                    font-size: 14px;
                    color: #232b38;
                    font-weight: 400;
                  "
                >
                  <%= product.product.name %>
                </td>
                <td
                  style="
                    padding: 12px;
                    font-size: 14px;
                    color: #232b38;
                    font-weight: 400;
                  "
                >
                  <%= product.quantity %>
                </td>
                <td
                  style="
                    padding: 12px;
                    font-size: 14px;
                    color: #232b38;
                    font-weight: 400;
                  "
                >
                  ₦ <%= productPrice.toLocaleString() %>
                </td>
                <td
                  style="
                    padding: 12px;
                    font-size: 14px;
                    color: #232b38;
                    font-weight: 400;
                  "
                >
                  ₦ <%= price.toLocaleString() %>
                </td>
              </tr>
              <% }); %>
            </tbody>
          </table>
        </td>
      </tr>

      <!-- Total -->
      <tr>
        <td colspan="2" style="padding: 0 24px; padding-top: 16px">
          <div
            style="
              padding: 13.5px 12px;
              background-color: #f0f2f5;
              border-radius: 12px;
            "
          >
            <div
              style="
                display: flex;
                justify-content: space-between;
                align-items: center;
                width: 100%;
              "
            >
              <span style="color: #667185">Total</span>
              <span style="color: #232b38; font-size: 14px; font-weight: 500">
                ₦<%= total.toLocaleString() %>
              </span>
            </div>
          </div>
        </td>
      </tr>

      <!-- Notes -->
      <tr>
        <td
          colspan="2"
          style="
            padding: 24px;
            padding-bottom: 90px;
            font-size: 14px;
            color: #101928;
          "
        >
          <strong>Notes</strong>
          <p><%=  note %></p>
        </td>
      </tr>
    </table>
  </body>
</html>

# legacy-api root URL (no /v2 suffix — admin BFF adds /v2 automatically)
# Must match legacy-api PORT (default 8000 in apps/legacy-api/.env)
NUXT_PUBLIC_LEGACY_API_BASE_URL=http://127.0.0.1:8000

# Optional: public host for supplier PO receipt emails (e.g. api.example.com)
# NUXT_PURCHASE_ORDER_RECEIPT_HOST=api.example.com

# Local dev: bootstrap first admin via POST /api/dev/bootstrap-admin
# NUXT_DEV_ADMIN_BOOTSTRAP_ENABLED=true
# NUXT_DEV_ADMIN_BOOTSTRAP_SECRET=change-me
# NUXT_DEV_MONGODB_URI=mongodb://127.0.0.1:27017/gosource

# legacy-api root (matches apps/legacy-api PORT)
NUXT_PUBLIC_LEGACY_API_BASE_URL=http://127.0.0.1:8000

# NUXT_PUBLIC_CREDIT_DOCUMENT_CDN_BASE_URL=https://your-bucket.ams3.digitaloceanspaces.com

NUXT_DEV_ADMIN_BOOTSTRAP_ENABLED=true
NUXT_DEV_ADMIN_BOOTSTRAP_SECRET=local-dev-bootstrap-change-me-8f3k2
NUXT_DEV_MONGODB_URI=mongodb://username:password@host:27017/database 

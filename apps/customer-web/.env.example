# legacy-api root (matches apps/legacy-api PORT)
NUXT_LEGACY_API_BASE_URL=http://127.0.0.1:8000

NUXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Paystack test public key (pk_test_...) for local/staging card payments.
# If checkout fails with ERR_SSL_BAD_RECORD_MAC or "Failed to fetch" in requests.js,
# use incognito without extensions — that error is usually VPN/ad-blocker/extension MITM, not this app.
# Wallet funding: Paystack webhooks must hit legacy-api POST /v2/paystack/webhook in production.
# In local dev, customer-web auto-calls /api/wallet/dev-confirm-funding after card pay (import.meta.dev only).
# Credit repayment: same pattern via /api/credit/dev-confirm-repayment (import.meta.dev only).
NUXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# Optional: switch back to apps/api (modern BFF) for experiments
# NUXT_CUSTOMER_API_MODE=modern
# NUXT_PUBLIC_API_BASE_URL=http://127.0.0.1:3005


# legacy-api root (matches apps/legacy-api PORT)
NUXT_LEGACY_API_BASE_URL=http://127.0.0.1:8000

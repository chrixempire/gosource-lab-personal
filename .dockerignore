# Keep the Docker build context lean. The Nuxt app Dockerfiles build from the
# repo root (pnpm workspace), so we keep all package.json / source / lockfile,
# but drop build artifacts, deps, and anything not needed to install + build.

**/node_modules
**/.nuxt
**/.output
**/.turbo
**/dist
**/coverage

.git
.github
.vscode

# Local env files — never bake secrets into an image.
**/.env
**/.env.*
!**/.env.example

# Test / tooling artifacts
**/test-results
**/playwright-report
**/*.log

# Docs / binaries that don't affect the build
docs
*.docx

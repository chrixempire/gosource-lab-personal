{
  "name": "gosource-lab",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "turbo run dev --filter=!@gosource/api",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "audit:deps": "pnpm -r audit",
    "audit:deps:prod": "pnpm -r audit --prod",
    "format": "prettier --write .",
    "prepare": "husky"
  },
  "devDependencies": {
    "eslint": "^9.35.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.6",
    "prettier": "^3.5.3",
    "turbo": "^2.9.9",
    "typescript": "^5.9.2"
  },
  "lint-staged": {
    "*.{js,ts,mjs,cjs,json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
